#!/usr/bin/env python3
"""kal-start <run dir> [--mode build|build-spec] [--base BRANCH]: preflight a Run, then write its run.md on a
first start.

<run dir> is <repo>/.kal/runs/<feature>. --base defaults to the main checkout's current branch.
- build: Tickets merge straight into the base branch.
- build-spec: the base becomes the Run's target; Tickets merge into an integration branch kal/<feature>, cut from
  it into its own worktree, and the integration branch reaches the target only at the end (kal-finish).
One Run is active per repo: another Run that is live (a listed Worker's pane is open, or its heartbeat is under
15 minutes old) and not paused makes this exit 4. Running the command again on a paused Run resumes it (the pause
flag is removed). Prints one line. Exit 0: `first start: …`, `resume: …` or `finished …`. Exit 1: a check failed;
the line is the fix. Exit 3: setup is missing. Exit 4: another Run is active; the line names it.
"""
import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

from _kal import commands, dirty, field, git, repo_of, run, stop, tickets

HERE = Path(__file__).resolve().parent


def trusted(repo):
    """Claude Code has accepted the folder-trust prompt for the repo or a folder above it (~/.claude.json)."""
    cfg = Path(os.environ["CLAUDE_CONFIG_DIR"]) / ".claude.json" if os.environ.get("CLAUDE_CONFIG_DIR") \
        else Path.home() / ".claude.json"
    try:
        projects = json.loads(cfg.read_text()).get("projects", {})
    except (OSError, ValueError):
        return True  # can't tell: don't block; the Worker's startup-prompt check still catches it
    return any(projects.get(str(d), {}).get("hasTrustDialogAccepted") for d in (repo, *repo.parents))

p = argparse.ArgumentParser(prog="kal-start")
p.add_argument("run_dir", type=Path)
p.add_argument("--mode", choices=("build", "build-spec"), default="build")
p.add_argument("--base")
a = p.parse_args()

if not os.environ.get("TMUX_PANE"):
    stop(1, "not inside tmux: run `tmux new -A -s kal claude` in this repo and type the command again")
run_dir = a.run_dir.resolve()
run_dir.mkdir(parents=True, exist_ok=True)
repo = repo_of(run_dir)
if not repo or run_dir.parent != repo / ".kal" / "runs":
    stop(1, f"{run_dir} is not <repo>/.kal/runs/<feature> in a git repo's main checkout")
if not (repo / "docs" / "agents").is_dir():
    stop(3, "no docs/agents/: run /kal:setup first")
if not commands(repo)["Verify"]:
    stop(3, "the Commands block in CLAUDE.md has no Verify command: run /kal:setup (or add `- Verify: `cmd``)")
if not trusted(repo):
    stop(1, f"Claude Code hasn't trusted {repo} yet, so every Worker would stop at the folder-trust prompt: run "
            "`claude` there once without --dangerously-skip-permissions, accept the prompt, then retry")
if run("git", "check-ignore", "-q", ".kal/runs", cwd=repo).returncode:
    stop(1, ".kal/ isn't gitignored: run /kal:setup, or add `.kal/` to .gitignore and commit it")

def active(other):
    """Another Run that is still going: not finished, and either a listed Worker's pane is still open (even when
    paused: those Workers are finishing their step, and may hold ports), or it isn't paused and its heartbeat is
    fresh."""
    text = (other / "run.md").read_text() if (other / "run.md").is_file() else ""
    if not text or field("Finished", text):
        return False
    panes = [w[2] for t in tickets(other) for w in t.workers if len(w) > 2]
    if any(run("tmux", "display", "-p", "-t", pane, "#{pane_id}", cwd=repo).stdout.strip() == pane for pane in panes):
        return True
    return not (other / "pause").exists() and time.time() - int(field("Heartbeat", text) or 0) < 900


for other in sorted((repo / ".kal" / "runs").iterdir()):
    if other.is_dir() and other != run_dir and active(other):
        paused = (other / "pause").exists()
        stop(4, f"active: {other.name} is " + ("paused, but its workers are finishing their current step: try again "
                "once their panes have closed" if paused else f"still building. Pause it first (`touch "
                f"{other / 'pause'}`: its workers finish their current step, then it stops), or wait for it"))

run_md = run_dir / "run.md"
LIVE = ("in-dev", "in-review", "fixing", "ready-to-merge", "merging", "parked", "needs-you")
if run_md.exists():
    text = run_md.read_text()
    if field("Finished", text):
        stop(0, f"finished at {field('Finished', text)}: this Run is done; to build the spec's remaining or "
                "backlog tickets, start a follow-up Run in <run dir>-2 (/kal:build-spec does this by itself)")
    live = [t for t in (run_dir / "tickets").glob("*.md") if field("Status", t.read_text()) in LIVE]
    if live or field("Mode", text) != "build":
        (run_dir / "pause").unlink(missing_ok=True)
        stop(0, f"resume: base branch {field('Base branch', text)}")
    # A single-ticket Run folder with nothing in flight: the next /kal:build starts afresh from the current branch.

base = a.base or git("symbolic-ref", "--short", "-q", "HEAD", cwd=repo)
if not base:
    stop(1, f"the main checkout {repo} is on a detached HEAD: check out the branch to build on first")
if git("rev-parse", "--verify", "-q", f"refs/heads/{base}", cwd=repo) == "":
    stop(1, f"no local branch {base}")
changed = dirty(repo)
if changed:
    stop(1, f"the main checkout has uncommitted changes ({', '.join(changed[:5])}): commit or stash them first")

# Green before we start: a red base would make every Ticket look broken. Reused if this commit passed before.
v = subprocess.run([str(HERE / "kal-verify"), str(repo), str(run_dir / "reports" / "base")], text=True,
                   stdout=subprocess.PIPE)
if v.returncode:
    stop(1, f"Verify is red on {base} ({v.stdout.split()[-1] if v.stdout.split() else '?'}): fix it first")

if run_md.exists() and a.mode == "build":  # a reused single-ticket Run folder: keep its Log, new base
    subprocess.run([str(HERE / "kal-set"), str(run_md), f"Base branch={base}", f"Heartbeat={int(time.time())}",
                    "--log", f"new build on {base}"], check=True)
    stop(0, f"first start: base branch {base} (Run folder reused)")
header = f"Mode: {a.mode}\nBase branch: {base}\n"
if a.mode == "build-spec":
    integration = f"kal/{run_dir.name}"
    wt = repo.parent / f"{repo.name}-kal" / f"{run_dir.name}-integration"
    wt.parent.mkdir(parents=True, exist_ok=True)
    r = run("git", "worktree", "add", "-q", "-b", integration, str(wt), base, cwd=repo)
    if r.returncode:
        stop(1, f"could not cut {integration} from {base} into {wt}: {r.stderr.strip()} (a leftover from an earlier "
                f"Run? remove it with `git worktree remove {wt}` and `git branch -D {integration}`)")
    header = f"Mode: build-spec\nBase branch: {integration}\nTarget branch: {base}\nIntegration worktree: {wt}\n"
run_md.write_text(f"# Run: {run_dir.name}\n\n{header}Phase: tickets\nStarted: {time.strftime('%Y-%m-%d %H:%M')}\n"
                  f"Heartbeat: {int(time.time())}\n\n## Notes\n\n## Log\n")
print(f"first start: base branch {base}" + (f", integration branch kal/{run_dir.name}" if a.mode == "build-spec" else ""))
