#!/bin/sh
# The plugin's Relay hooks (hooks/hooks.json). Without a request for this pane (written by kal-relay)
# both do nothing, so they're harmless in Workers and outside tmux.
#   stop   Stop hook: type /clear into the pane, once per request even if Stop fires again
#   clear  SessionStart, matcher clear: type the resume line into the fresh context, drop the request
# Keys are typed detached after a short delay, so the hook returns before they land. If a new turn
# started meanwhile (a Worker finished), the keys queue behind it. KAL_RELAY_DELAY (s) tunes the wait.
pane=${TMUX_PANE:-}
[ -n "$pane" ] || exit 0
req="${TMPDIR:-/tmp}/kal-relay-${pane#%}"
[ -f "$req" ] || exit 0
d=${KAL_RELAY_DELAY:-2}
case ${1:-} in
  stop)
    [ -f "$req.clearing" ] && exit 0
    touch "$req.clearing"
    nohup sh -c 'sleep "$1"; tmux send-keys -t "$2" /clear Enter' sh "$d" "$pane" </dev/null >/dev/null 2>&1 & ;;
  clear)
    nohup sh -c 'sleep "$1"; tmux send-keys -t "$2" -l -- "$(cat "$3")"; tmux send-keys -t "$2" Enter
                 rm -f "$3" "$3.clearing"' sh "$((d + 1))" "$pane" "$req" </dev/null >/dev/null 2>&1 & ;;
esac
exit 0
