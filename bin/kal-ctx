#!/usr/bin/env python3
"""Print this Claude session's context size in tokens: input + cache read + cache creation
of the last main-thread usage record in its own transcript. Usage: kal-ctx [run dir]

With the run dir it also records `Context: <tokens>k` in its run.md for the Board,
and adds " relay" to the line at KAL_RELAY_AT tokens (250000): time for the Orchestrator to Relay.
ponytail: one fixed threshold; a session on a 200k-window model auto-compacts before it, lower KAL_RELAY_AT there."""
import glob
import json
import os
import subprocess
import sys
from pathlib import Path

sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or sys.exit("kal-ctx: not inside a Claude Code session")
config = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
found = glob.glob(os.path.join(glob.escape(config), "projects", "*", f"{sid}.jsonl"))
if not found:
    sys.exit(f"kal-ctx: no transcript for session {sid}")

last = None
with open(found[0]) as f:
    for line in f:
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        u = (rec.get("message") or {}).get("usage") if isinstance(rec, dict) else None
        if u and not rec.get("isSidechain"):
            last = u
tokens = sum(last.get(k, 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")) \
    if last else 0
if len(sys.argv) > 1:
    kal_set = Path(__file__).resolve().parent / "kal-set"
    subprocess.run([str(kal_set), str(Path(sys.argv[1], "run.md")), f"Context={round(tokens / 1000)}k"],
                   check=True)
    if tokens >= int(os.environ.get("KAL_RELAY_AT", 250000)):
        print(tokens, "relay")
        sys.exit()
print(tokens)
