#!/usr/bin/env python3
"""kal-set FILE [Key=value ...] [--worker "ROLE MODEL PANE HH:MM" ...] [--no-worker ROLE] [--notes FILE|-]
[--log MESSAGE]: the Orchestrator's one way to edit a Ticket or the Run file.

Each Key=value replaces that header line (plain `Key: v` or bold `**Key:** v`, keeping its style; the header is
the text before the first `## ` heading), or adds a plain one after the block of header lines that holds
`Status:` (else the first header block). An empty value leaves `Key:` with nothing after it. Each --worker adds
one entry to the comma-separated `Workers:` line, replacing that Role's entry if it has one; --no-worker drops
that Role's entry. The other Workers stay listed. --log appends `<YYYY-MM-DD HH:MM> MESSAGE` as the last line of
the `## Log` section (before any later `## ` heading), adding the heading at the end if it's missing. --notes
replaces the body of the `## Notes` section (up to the next `## ` heading) with FILE's text, or stdin's for `-`,
adding the heading at the end if it's missing: the Relay's rewrite of the Run file's Notes. The text may not
hold a `## ` heading.
"""
import argparse
import re
import time
from pathlib import Path

from _kal import field

HEADER = re.compile(r"^(?:\*\*)?[A-Z][\w ]*:(?:\*\*)?(?:[ \t].*)?$")

p = argparse.ArgumentParser(prog="kal-set")
p.add_argument("file", type=Path)
p.add_argument("pairs", nargs="*", metavar="Key=value")
p.add_argument("--log")
p.add_argument("--notes", type=argparse.FileType(), metavar="FILE|-")
p.add_argument("--worker", action="append", default=[], metavar="ROLE MODEL PANE HH:MM")
p.add_argument("--no-worker", metavar="ROLE")
a = p.parse_args()
text = a.file.read_text()
lines = text.splitlines()

if a.worker or a.no_worker:
    new = [w.strip() for w in a.worker]
    drop = {w.split()[0] for w in new} | {a.no_worker}
    workers = [w.strip() for w in (field("Workers", text) or "").split(",") if w.strip() and w.split()[0] not in drop]
    a.pairs.append("Workers=" + ", ".join(workers + new))

for pair in a.pairs:
    key, sep, value = pair.partition("=")
    if not sep:
        p.error(f"not Key=value: {pair}")
    pat = re.compile(rf"^(\*\*)?{re.escape(key)}:(\*\*)?[ \t]*.*$")
    head = next((i for i, l in enumerate(lines) if l.startswith("## ")), len(lines))  # header: before any `## `
    i = next((i for i in range(head) if pat.match(lines[i])), None)
    if i is not None:
        m = pat.match(lines[i])
        lines[i] = f"{m[1] or ''}{key}:{m[2] or ''} {value}".rstrip()
        continue
    at = next((i for i in range(head) if re.match(r"^(\*\*)?Status:", lines[i])), None)
    if at is None:
        at = next((i for i in range(head) if HEADER.match(lines[i])), head - 1)
    while at + 1 < len(lines) and HEADER.match(lines[at + 1]):
        at += 1
    lines.insert(at + 1, f"{key}: {value}".rstrip())


def section(name):
    """The `## name` section's heading index and end (the next `## ` heading, or the end); adds it if missing."""
    start = next((i for i, l in enumerate(lines) if re.match(rf"^## {name}\s*$", l)), None)
    if start is None:
        while lines and not lines[-1].strip():
            lines.pop()
        lines.extend(["", f"## {name}"])
        start = len(lines) - 1
    return start, next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))


if a.notes:
    notes = a.notes.read().strip()
    if re.search(r"^## ", notes, re.M):
        p.error("--notes text can't hold a `## ` heading (it would end the section); use `### `")
    start, end = section("Notes")
    lines[start + 1:end] = ([""] + notes.splitlines() if notes else []) + ([""] if end < len(lines) else [])

if a.log:
    start, end = section("Log")
    body = lines[start + 1:end]
    while body and not body[-1].strip():
        body.pop()
    body += ([""] if not body else []) + [f"{time.strftime('%Y-%m-%d %H:%M')} {a.log}"]
    lines[start + 1:end] = body + ([""] if end < len(lines) else [])

a.file.write_text("\n".join(lines) + "\n")
