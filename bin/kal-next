#!/usr/bin/env python3
"""kal-next <run dir>: what the Orchestrator starts now, after every Worker completion or merge.

Prints one line per Ticket that gets a developer now, within the free developer slots (3 at once, KAL_DEV_SLOTS):
  resume <ticket file>   a parked Ticket whose `Waits on:` Tickets are all merged (first: it holds a worktree)
  start <ticket file>    a `ready` Ticket whose `Blocked by:` Tickets are all merged (the frontier)
lowest number first. Only developers take a slot; every other Role runs whenever it's needed.
When nothing is live and nothing can move, it prints one `idle: …` line instead: `idle: all merged` (time for
the end of the spec), `idle: paused`, or what holds the rest (needs you / waiting on those / parked / can't
start). Prints nothing while Workers are live but no slot work is ready. Also stamps run.md's Heartbeat.
"""
import os
import subprocess
import sys
import time
from pathlib import Path

from _kal import Ticket, stop, tickets

HERE = Path(__file__).resolve().parent
MOVING = ("in-dev", "in-review", "fixing", "ready-to-merge", "merging")

if len(sys.argv) != 2 or not (Path(sys.argv[1]) / "run.md").is_file():
    stop(2, "usage: kal-next <run dir>  (a Run folder with run.md)")
run_dir = Path(sys.argv[1]).resolve()
subprocess.run([str(HERE / "kal-set"), str(run_dir / "run.md"), f"Heartbeat={int(time.time())}"], check=True)

ts = tickets(run_dir)
final = sorted((run_dir / "tickets").glob("00-*.md"))
merged = {t.nn for t in ts if t.status in ("merged", "dropped")}  # dropped: resolved, by the human
live = [w for t in ts for w in t.workers] + [w for f in final for w in Ticket(f).workers]
paused = (run_dir / "pause").exists()
nn = lambda xs: ", ".join(t.nn for t in xs)

if not paused:
    slots = int(os.environ.get("KAL_DEV_SLOTS", 3)) - sum(1 for w in live if w[0] == "developer")
    resumable = [t for t in ts if t.status == "parked" and t.waits_on and set(t.waits_on) <= merged]
    frontier = [t for t in ts if t.status == "ready" and set(t.blocked_by) <= merged]
    picks = [("resume", t) for t in resumable] + [("start", t) for t in frontier]
    for action, t in picks[:max(slots, 0)]:
        print(action, t.path)
    if picks:
        sys.exit(0)

if live or any(t.status in MOVING for t in ts):
    sys.exit(0)
open_ = [t for t in ts if t.status not in ("merged", "dropped")]
if not open_:
    stop(0, "idle: all merged")
if paused:
    stop(0, f"idle: paused (remove {run_dir / 'pause'} and run the build again to resume)")

needs = [t for t in open_ if t.status == "needs-you"]
held = {t.nn for t in needs}
grew = True
while grew:  # everything that waits, directly or through others, on a Ticket that needs you
    grew = False
    for t in open_:
        if t.nn not in held and set(t.blocked_by + t.waits_on) & held:
            held.add(t.nn)
            grew = True
waiting = [t for t in open_ if t.nn in held and t.status != "needs-you"]
rest = [t for t in open_ if t.nn not in held]
parts = [f"needs you: {nn(needs)}" if needs else "", f"waiting on them: {nn(waiting)}" if waiting else "",
         "can't start: " + ", ".join(f"{t.nn} ({t.status}, waits on {', '.join(t.waits_on + t.blocked_by) or '?'})"
                                     for t in rest) if rest else ""]
print("idle: " + "; ".join(p for p in parts if p))
